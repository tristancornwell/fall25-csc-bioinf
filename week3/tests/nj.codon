__name__ = "biotite.sequence.phylo"
__author__ = "Patrick Kunzmann"
__all__ = ["neighbor_joining"]

from typing import List, Optional
from .tree import Tree, TreeNode
import numpy as np

# maximum float for float64
MAX_FLOAT = np.finfo(np.float64).max


def neighbor_joining(distances: np.ndarray):
    """
    neighbor_join(distances)

    Perform hierarchical clustering using the
    *neighbor joining* algorithm. 

    In contrast to UPGMA this algorithm does not assume a constant
    evolution rate. The resulting tree is considered to be unrooted.

    Parameters
    ----------
    distances : ndarray, shape=(n,n)
        Pairwise distance matrix.

    Returns
    -------
    tree : Tree
        A rooted tree. The `index` attribute in the leaf
        :class:`TreeNode` objects refer to the indices of `distances`.

    Raises
    ------
    ValueError
        If the distance matrix is not symmetric
        or if any matrix entry is below 0.
    """
    if distances.shape[0] != distances.shape[1] \
            or not np.allclose(distances.T, distances):
        raise ValueError("Distance matrix must be symmetric")
    if np.isnan(distances).any():
        raise ValueError("Distance matrix contains NaN values")
    if (distances >= MAX_FLOAT).any():
        raise ValueError("Distance matrix contains infinity")
    if distances.shape[0] < 4:
        raise ValueError("At least 4 nodes are required")
    if (distances < 0).any():
        raise ValueError("Distances must be positive")

    n = distances.shape[0]

    # Keep track of clustered indices: list of TreeNode or None
    nodes: List[TreeNode] = [TreeNode(index=i) for i in range(n)]

    # Indicates whether an index in the distance matrix has already been
    # clustered and the respective rows and columns can be ignored
    is_clustered_v = np.full(n, False, dtype=np.uint8)

    # Number of remaining nodes (unclustered)
    n_rem_nodes = n - int(np.count_nonzero(np.asarray(is_clustered_v)))

    # The divergence of a taxon: relative evolution rate
    divergence_v = np.zeros(n, dtype=np.float64)

    # Triangular matrix for divergence-corrected distances
    corr_distances_v = np.zeros((n, n), dtype=np.float64)

    # Work on a float64 copy
    distances_v = distances.astype(np.float64, copy=True)

    # Main loop
    while True:
        # Calculate divergence for each unclustered node
        for i in range(n):
            if is_clustered_v[i]:
                continue
            dist_sum = 0.0
            for k in range(n):
                if is_clustered_v[k]:
                    continue
                dist_sum += float(distances_v[i, k])
            divergence_v[i] = np.float64(dist_sum)

        # Calculate corrected distance matrix
        for i in range(n):
            if is_clustered_v[i]:
                continue
            for j in range(i):
                if is_clustered_v[j]:
                    continue
                corr_distances_v[i, j] = np.float64(
                    (n_rem_nodes - 2) * float(distances_v[i, j])
                    - float(divergence_v[i]) - float(divergence_v[j])
                )

        # Find minimum corrected distance
        dist_min = MAX_FLOAT
        i_min = -1
        j_min = -1
        for i in range(n):
            if is_clustered_v[i]:
                continue
            for j in range(i):
                if is_clustered_v[j]:
                    continue
                dist = float(corr_distances_v[i, j])
                if dist < dist_min:
                    dist_min = dist
                    i_min = i
                    j_min = j

        # Check if all nodes are clustered
        if i_min == -1 or j_min == -1:
            # All leaf nodes clustered
            break

        # Compute pairwise node distances
        node_dist_i = 0.5 * (
            float(distances_v[i_min, j_min])
            + (float(divergence_v[i_min]) - float(divergence_v[j_min]))
              / float(n_rem_nodes - 2)
        )
        node_dist_j = 0.5 * (
            float(distances_v[i_min, j_min])
            + (float(divergence_v[j_min]) - float(divergence_v[i_min]))
              / float(n_rem_nodes - 2)
        )

        if n_rem_nodes > 3:
            # Still clustering
            nodes[i_min] = TreeNode(
                (nodes[i_min], nodes[j_min]),
                (node_dist_i, node_dist_j)
            )
            # nodes[j_min] = None
            is_clustered_v[j_min] = True

        else:
            # Final clustering: combine last 3 nodes into root
            is_clustered_v[i_min] = True
            is_clustered_v[j_min] = True
            remaining_idx = np.where(~np.asarray(is_clustered_v, dtype=bool))[0][0]

            node_dist_k = 0.5 * (
                float(distances_v[i_min, remaining_idx])
                + float(distances_v[j_min, remaining_idx])
                - float(distances_v[i_min, j_min])
            )

            root = TreeNode(
                (nodes[i_min], nodes[j_min], nodes[remaining_idx]),
                (node_dist_i, node_dist_j, node_dist_k)
            )
            return Tree(root)

        # Update distance matrix
        for k in range(n):
            if not is_clustered_v[k] and k != i_min:
                dist = 0.5 * (
                    float(distances_v[i_min, k])
                    + float(distances_v[j_min, k])
                    - float(distances_v[i_min, j_min])
                )
                distances_v[i_min, k] = np.float64(dist)
                distances_v[k, i_min] = np.float64(dist)

        # Update remaining nodes count
        n_rem_nodes = n - int(np.count_nonzero(np.asarray(is_clustered_v)))
