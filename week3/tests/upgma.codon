__name__ = "biotite.sequence.phylo"
__author__ = "Patrick Kunzmann"
__all__ = ["upgma"]

from typing import List, Optional

from .tree import Tree, TreeNode
import numpy as np

# maximum float for float64
MAX_FLOAT = np.finfo(np.float64).max


def upgma(distances: np.ndarray):
    """
    upgma(distances)

    Perform hierarchical clustering using the
    *unweighted pair group method with arithmetic mean* (UPGMA).

    This algorithm produces leaf nodes with the same distance to the
    root node.

    Parameters
    ----------
    distances : ndarray, shape=(n,n)
        Pairwise distance matrix.

    Returns
    -------
    tree : Tree
        A rooted binary tree. The `index` attribute in the leaf
        :class:`TreeNode` objects refer to the indices of `distances`.

    Raises
    ------
    ValueError
        If the distance matrix is not symmetric
        or if any matrix entry is below 0.
    """
    # Basic validation
    if distances.shape[0] != distances.shape[1] \
            or not np.allclose(distances.T, distances):
        raise ValueError("Distance matrix must be symmetric")
    if np.isnan(distances).any():
        raise ValueError("Distance matrix contains NaN values")
    if (distances >= MAX_FLOAT).any():
        raise ValueError("Distance matrix contains infinity")
    if (distances < 0).any():
        raise ValueError("Distances must be positive")

    n = distances.shape[0]

    # Keep track on clustered indices: list of TreeNode or None
    nodes: List[TreeNode] = [TreeNode(index=i) for i in range(n)]

    # Indicates whether an index in the distance matrix has already been
    # clustered and the respective rows and columns can be ignored
    is_clustered_v = np.full(n, False, dtype=np.uint8)

    # Number of indices in the current node (cardinality)
    # (required for proportional averaging)
    cluster_size_v = np.ones(n, dtype=np.uint32)

    # Distance of each node from leaf nodes,
    # used for calculation of distance to child nodes
    node_heights = np.zeros(n, dtype=np.float64)

    # Work on a float64 copy of the distances
    distances_v = distances.astype(np.float64, copy=True)

    # Exit loop via 'break'
    while True:
        # Find minimum distance
        dist_min = MAX_FLOAT
        i_min = -1
        j_min = -1

        for i in range(n):
            if is_clustered_v[i]:
                continue
            # only consider j < i (matrix is symmetric)
            for j in range(i):
                if is_clustered_v[j]:
                    continue
                dist = float(distances_v[i, j])
                if dist < dist_min:
                    dist_min = dist
                    i_min = i
                    j_min = j

        if i_min == -1 or j_min == -1:
            # No distance found -> all leaf nodes are clustered
            break

        # Cluster the nodes with minimum distance
        # replacing the node at position i_min and
        # leaving the node at position j_min empty
        height = dist_min / 2.0
        nodes[i_min] = TreeNode(
            [nodes[i_min], nodes[j_min]],
            [height - float(node_heights[i_min]), height - float(node_heights[j_min])]
        )
        node_heights[i_min] = np.float64(height)

        # Mark position j_min as clustered
        # nodes[j_min] = None
        is_clustered_v[j_min] = True

        # Calculate arithmetic mean distances of child nodes
        # as distances for new node and update matrix
        for k in range(n):
            if not is_clustered_v[k] and k != i_min:
                # weighted mean by cluster sizes
                mean = (
                    (
                        float(distances_v[i_min, k]) * int(cluster_size_v[i_min])
                        + float(distances_v[j_min, k]) * int(cluster_size_v[j_min])
                    ) / (int(cluster_size_v[i_min]) + int(cluster_size_v[j_min]))
                )
                distances_v[i_min, k] = np.float64(mean)
                distances_v[k, i_min] = np.float64(mean)

        # Update cluster size of new node
        cluster_size_v[i_min] = cluster_size_v[i_min] + cluster_size_v[j_min]

    # The root node must be at the last index
    return Tree(nodes[len(nodes) - 1])
