# simple helper functions for assertions
def assert_equal(a, b, msg=""):
    if a != b:
        print(f"Assertion failed: {a} != {b} {msg}")
        exit(1)

def assert_true(cond, msg=""):
    if not cond:
        print(f"Assertion failed: condition is false {msg}")
        exit(1)

def test_tree_node_basic():
    # create a trivial TreeNode (or whatever class your port defines)
    node = phylo.tree.TreeNode(index=0)
    assert_equal(node.index, 0, "TreeNode index should be set correctly")

