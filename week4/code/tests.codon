import time
from global_align import global_align
from local_align import local_align
from fitting_align import fitting_align
from affine_global_align import affine_global_align

def read_fasta(filename: str) -> dict[str, str]:
    seqs: dict[str, str] = {}
    name = ""
    seq_lines: List[str] = []
    with open(f"data/{filename}") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            if line.startswith(">"):
                if name != "":
                    seqs[name] = "".join(seq_lines)
                    seq_lines = []
                name = line[1:]
            else:
                seq_lines.append(line)
        if name != "":
            seqs[name] = "".join(seq_lines)
    return seqs

def check_score_global(target_file: str, query_file: str, score: int):
    expected: int = 0

    # choose expected score based on method + target file
    if target_file == "t1.fa" and query_file == "q1.fa":
        expected = 4
    elif target_file == "t2.fa" and query_file == "q2.fa":
        expected = 11
    elif target_file == "t3.fa" and query_file == "q3.fa":
        expected = 96
    elif target_file == "t4.fa" and query_file == "q4.fa":
        expected = -10
    elif target_file == "t5.fa" and query_file == "q5.fa":
        expected = -66
    elif target_file == "MT-human.fa" and query_file == "MT-orang.fa":
        expected = 33399
    else:
        print(f"No expected score for {target_file}/{query_file}")
        return

    assert score == expected, f"Expected {expected}, got {score}"

