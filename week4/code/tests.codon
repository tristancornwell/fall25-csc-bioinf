def run_test(method: str, lang: str, target_file: str, query_file: str):
    # parse fasta files for input sequences
    t = read_fasta(target_file)
    q = read_fasta(query_file)
    target_seq = list(t.values())[0]
    query_seq = list(q.values())[0]

    start = time.time()

    # determine which alignment to run and check score
    if method.startswith("global"):
        score = global_align(query_seq, target_seq)
        check_score_global(target_file, query_file, score)
    elif method.startswith("local"):
        score = local_align(query_seq, target_seq)
        check_score_local(target_file, query_file, score)
    elif method.startswith("affine"):
        score = affine_global_align(query_seq, target_seq)
        check_score_affine(target_file, query_file, score)
    elif method.startswith("fitting"):
        score = fitting_align(query_seq, target_seq)
        check_score_fitting(target_file, query_file, score)

    end = time.time()
    runtime_ms = (end - start) * 1000

    # pad output columns
    method_col = method.ljust(18)
    lang_col = lang.ljust(12)
    runtime_col = str(runtime_ms) + "ms"

    print(method_col + lang_col + runtime_col)

if __name__ == "__main__":
    # enumerate test cases to run
    pairs: List[Tuple[str, str, str, str]] = [
        ("global-q1", "codon", "t1.fa", "q1.fa"),
        ("global-q2", "codon", "t2.fa", "q2.fa"),
        ("global-q3", "codon", "t3.fa", "q3.fa"),
        ("global-q4", "codon", "t4.fa", "q4.fa"),
        ("global-q5", "codon", "t5.fa", "q5.fa"),
        ("global-mt_human", "codon", "MT-human.fa", "MT-orang.fa"),
        ("local-q1", "codon", "t1.fa", "q1.fa"),
        ("local-q2", "codon", "t2.fa", "q2.fa"),
        ("local-q3", "codon", "t3.fa", "q3.fa"),
        ("local-q4", "codon", "t4.fa", "q4.fa"),
        ("local-q5", "codon", "t5.fa", "q5.fa"),
        ("local-mt_human", "codon", "MT-human.fa", "MT-orang.fa"),
        ("fitting-q1", "codon", "t1.fa", "q1.fa"),
        ("fitting-q2", "codon", "t2.fa", "q2.fa"),
        ("fitting-q3", "codon", "t3.fa", "q3.fa"),
        ("fitting-q4", "codon", "t4.fa", "q4.fa"),
        ("fitting-q5", "codon", "t5.fa", "q5.fa"),
        ("fitting-mt_human", "codon", "MT-human.fa", "MT-orang.fa"),
        ("affine-q1", "codon", "t1.fa", "q1.fa"),
        ("affine-q2", "codon", "t2.fa", "q2.fa"),
        ("affine-q3", "codon", "t3.fa", "q3.fa"),
        ("affine-q4", "codon", "t4.fa", "q4.fa"),
        ("affine-q5", "codon", "t5.fa", "q5.fa"),
        ("affine-mt_human", "codon", "MT-human.fa", "MT-orang.fa")
    ]

    for method, lang, tfile, qfile in pairs:
        run_test(method, lang, tfile, qfile)
